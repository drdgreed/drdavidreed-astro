# Copy this file to `.env.development.local` and fill in your real Anthropic
# key for local `vercel dev` testing. NEVER commit a real key.
#
# In Vercel production, set the same vars via dashboard or `vercel env add`.

# Required — Anthropic Console (https://console.anthropic.com) → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional — pin to a specific model snapshot if you want deterministic output.
# Defaults to claude-sonnet-4-5 if unset.
# CLAUDE_MODEL=claude-sonnet-4-5

# Optional — override endpoints if you ever host the chat/analyzer elsewhere.
# Both default to /api/chat and /api/analyze on the same origin.
# PUBLIC_CHAT_URL=/api/chat
# PUBLIC_ANALYZE_URL=/api/analyze
