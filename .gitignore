# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# package-lock.json — temporarily skipped while we debug the Vercel
# "Invalid Version:" build failure. Vercel resolves fresh from package.json
# via "npm install --no-package-lock" in vercel.json. Re-add when the
# upstream lockfile issue is identified and fixed.
package-lock.json

# api/ — Vercel serverless functions for /api/chat and /api/analyze.
# Held back from initial deploy because top-level api/ + Astro v6
# without @astrojs/vercel adapter doesn't reliably route functions.
# Files preserved locally; to re-introduce, install @astrojs/vercel
# adapter and move handlers to src/pages/api/*.ts (Astro endpoint
# convention) instead of top-level api/.
api/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables — all .env.* variants stay local
.env
.env.*
!.env.example

# vercel CLI metadata (linked project, ephemeral logs)
.vercel/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.vercel
