---
/**
 * /portfolio — the white-paper series, projects, papers, patents.
 *
 * The series is listed from the `papers` content collection, so a paper's
 * title, version or subtitle changes here when the paper changes. The other
 * cards render as static HTML (full descriptions inlined as data-* attrs
 * → SEO-indexable since they're in the DOM), grouped into sections by
 * category. The details modal is wired via a small inline script.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { portfolioItems, type PortfolioCategory } from '../data/portfolio';

// The hub (Part 7) is the entry point, so it leads; Parts 1–6 follow in order.
const papers = (await getCollection('papers')).sort((a, b) => a.data.seriesPart - b.data.seriesPart);
const hub = papers.find((p) => p.data.seriesPart === 7);
const series = hub ? [hub, ...papers.filter((p) => p !== hub)] : papers;

const sections: Array<{ id: string; label: string; categories: PortfolioCategory[] }> = [
  { id: 'projects', label: 'Projects', categories: ['github'] },
  { id: 'papers', label: 'Papers & case studies', categories: ['whitepaper', 'casestudy', 'guidance', 'research'] },
  { id: 'patents', label: 'Patents', categories: ['patent'] },
];
const sectionItems = sections.map((s) => ({
  ...s,
  items: portfolioItems.filter((item) => s.categories.includes(item.category)),
}));

const categoryColor = (cat: PortfolioCategory) => {
  switch (cat) {
    case 'casestudy': return 'bg-teal-500/20 text-teal-300 border-teal-500/30';
    case 'patent': return 'bg-rose-500/20 text-rose-300 border-rose-500/30';
    case 'github': return 'bg-purple-500/20 text-purple-300 border-purple-500/30';
    case 'whitepaper': return 'bg-blue-500/20 text-blue-300 border-blue-500/30';
    case 'research': return 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
    case 'guidance': return 'bg-amber-500/20 text-amber-300 border-amber-500/30';
  }
};
---

<BaseLayout
  title="AI/ML Projects, Patents & White Papers"
  description="Open-source agentic AI projects, white papers, and two US patents from David Reed, PhD — 35+ years of production AI/ML engineering and product leadership."
  path="/portfolio/"
>
  <section class="section-container py-20">
    {/* Header */}
    <div class="text-center mb-12">
      <h1 class="heading-section font-serif font-semibold mb-4">Portfolio &amp; Insights</h1>
      <p class="text-muted-foreground max-w-2xl mx-auto">
        A curated collection of open-source projects, published research, and career guidance
        from 35+ years building production systems.
      </p>
    </div>

    {/* Jump links: one per section, so each kind of visitor reaches theirs in one click. */}
    <nav aria-label="Portfolio sections" class="flex flex-wrap justify-center gap-3 mb-14">
      {[{ id: 'series', label: 'Series' }, ...sections].map((s) => (
        <a
          href={`#${s.id}`}
          class="px-4 py-2 rounded-full border border-border text-sm text-muted-foreground hover:border-primary hover:text-primary transition-colors"
        >
          {s.label}
        </a>
      ))}
    </nav>

    {/* The series: one compact numbered list, each row straight to its paper. */}
    <section id="series" class="scroll-mt-24 mb-16" aria-labelledby="series-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-2">
        <h2 id="series-heading" class="text-2xl font-serif font-semibold">Agentic AI Governance in Practice</h2>
        <a href="/papers/" class="text-sm text-primary hover:underline">Read the series →</a>
      </div>
      <p class="text-muted-foreground mb-6 max-w-3xl">
        A seven-part white-paper series that takes an agentic AI system from governance concept to monitored
        production. Start with the delivery workflow, which ties the other six together.
      </p>
      <ol class="grid gap-3">
        {series.map((p) => (
          <li>
            <a
              href={`/papers/${p.id}/`}
              class="group glass-card-hover flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-5 px-5 py-4 hover:border-primary/50"
            >
              <span class="shrink-0 sm:w-36 text-xs font-medium text-primary">
                {p.data.seriesPart === 7 ? 'Start here · Part 7' : `Part ${p.data.seriesPart}`}
              </span>
              <span class="flex flex-col gap-1">
                <span class="font-serif font-semibold text-foreground group-hover:text-primary transition-colors">
                  {p.data.title} <span class="text-xs font-sans font-normal text-muted-foreground">v{p.data.version}</span>
                </span>
                <span class="text-sm text-muted-foreground">{p.data.subtitle}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {sectionItems.map((section) => (
      <section id={section.id} class="scroll-mt-24 mb-16" aria-labelledby={`${section.id}-heading`}>
        <h2 id={`${section.id}-heading`} class="text-2xl font-serif font-semibold mb-6">{section.label}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-fr">
          {section.items.map((item) => (
            <article
              data-category={item.category}
              data-id={item.id}
              data-full-description={item.fullDescription}
              data-link={item.link ?? ''}
              data-metrics={item.metrics ?? ''}
              data-tags={item.tags.join('||')}
              class="group glass-card-hover p-0 cursor-pointer hover:border-primary/50 flex flex-col"
            >
              <button type="button" data-portfolio-trigger class="text-left w-full p-6 flex flex-col flex-1">
                {/* Badge and metrics stack rather than sharing a row: side-by-side left the
                    metrics pill ~154px, which forced copy to be written to fit the pill.
                    On its own line it gets the full card width, so the copy sets the terms. */}
                <div class="mb-3">
                  <span class={`inline-block px-2 py-1 rounded-lg text-xs font-medium border ${categoryColor(item.category)}`}>
                    {item.category}
                  </span>
                  {item.metrics && (
                    <span class="block mt-2 truncate text-xs text-muted-foreground" title={item.metrics}>
                      {item.metrics}
                    </span>
                  )}
                </div>
                <h3 class="text-lg font-serif font-semibold text-foreground group-hover:text-primary transition-colors mb-3">
                  {item.title}
                </h3>
                <p class="text-sm text-muted-foreground mb-4 flex-1">{item.description}</p>
                <div class="flex flex-wrap gap-2">
                  {item.tags.slice(0, 6).map((t) => (
                    <span class="text-xs bg-muted/50 text-muted-foreground border border-border px-2 py-1 rounded">{t}</span>
                  ))}
                </div>
                <span class="text-xs text-primary opacity-0 group-hover:opacity-100 transition-opacity mt-4">
                  View details →
                </span>
              </button>
              {/* Outside the button: a link cannot sit inside a button. */}
              {item.note && (
                <a href={item.note.link} class="block px-6 pb-5 -mt-1 text-xs text-primary hover:underline">
                  {item.note.text}
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>

  {/* Modal — single instance, populated dynamically. */}
  <div
    id="portfolio-modal"
    class="hidden fixed inset-0 z-50 items-center justify-center p-4"
    aria-modal="true"
    role="dialog"
  >
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-modal-backdrop></div>
    <div class="relative glass-card max-w-2xl w-full max-h-[85vh] overflow-y-auto p-8">
      <button
        type="button"
        data-modal-close
        aria-label="Close"
        class="absolute top-4 right-4 p-2 rounded-full hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
      <div class="flex items-center gap-3 mb-3">
        <span data-modal-category class="px-2 py-1 rounded-lg text-xs font-medium border"></span>
        <span data-modal-metrics class="text-xs text-muted-foreground bg-muted px-2 py-1 rounded-full"></span>
      </div>
      <h2 data-modal-title class="text-2xl font-serif mb-4"></h2>
      <p data-modal-body class="text-muted-foreground leading-relaxed mb-6 whitespace-pre-wrap"></p>
      <div data-modal-tags class="flex flex-wrap gap-2 mb-6"></div>
      <a
        data-modal-link
        class="hidden inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-lg text-sm font-medium hover:bg-primary-hover transition-colors"
      >
        View Project →
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  /**
   * Inline interactivity: clicking a card opens the portfolio modal with
   * its full description and link.
   *
   * Note: every data-* attribute is treated as plain text (textContent),
   * never assigned via innerHTML, so user-content XSS isn't possible even
   * if the data file ever sources from a CMS later.
   */

  // ─── Modal ──────────────────────────────────────────────────────
  const modal = document.getElementById('portfolio-modal') as HTMLElement | null;
  if (!modal) throw new Error('portfolio modal missing');

  const showModal = (article: HTMLElement) => {
    const title = article.querySelector('h3')?.textContent ?? '';
    const fullDesc = article.dataset.fullDescription ?? '';
    const link = article.dataset.link ?? '';
    const metrics = article.dataset.metrics ?? '';
    const tags = (article.dataset.tags ?? '').split('||').filter(Boolean);
    const category = article.dataset.category ?? '';

    modal.querySelector<HTMLElement>('[data-modal-title]')!.textContent = title;
    modal.querySelector<HTMLElement>('[data-modal-body]')!.textContent = fullDesc;
    modal.querySelector<HTMLElement>('[data-modal-category]')!.textContent = category;

    const metricsEl = modal.querySelector<HTMLElement>('[data-modal-metrics]')!;
    metricsEl.textContent = metrics;
    metricsEl.style.display = metrics ? '' : 'none';

    const tagContainer = modal.querySelector<HTMLElement>('[data-modal-tags]')!;
    tagContainer.replaceChildren(); // clear without using innerHTML
    tags.forEach((t) => {
      const span = document.createElement('span');
      span.className = 'text-xs bg-muted/50 text-muted-foreground border border-border px-2 py-1 rounded';
      span.textContent = t;
      tagContainer.appendChild(span);
    });

    const linkEl = modal.querySelector<HTMLAnchorElement>('[data-modal-link]')!;
    if (link) {
      linkEl.href = link;
      // Only links off the site open a new tab; the site's own pages stay in this one.
      const external = new URL(link, location.href).origin !== location.origin;
      if (external) {
        linkEl.target = '_blank';
        linkEl.rel = 'noopener noreferrer';
      } else {
        linkEl.removeAttribute('target');
        linkEl.removeAttribute('rel');
      }
      linkEl.classList.remove('hidden');
    } else {
      linkEl.classList.add('hidden');
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const hideModal = () => {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLButtonElement>('[data-portfolio-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const article = btn.closest('article');
      if (article) showModal(article as HTMLElement);
    });
  });

  modal.querySelector('[data-modal-backdrop]')!.addEventListener('click', hideModal);
  modal.querySelector('[data-modal-close]')!.addEventListener('click', hideModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) hideModal();
  });
</script>
