---
/**
 * /fit-check — paste a JD, get an honest fit assessment.
 *
 * The interactive analyzer is a React island (FitCheck.tsx). Backend
 * endpoint is configurable via the PUBLIC_ANALYZE_URL env var; UI shows
 * a "backend pending" message until that's set.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FitCheck from '../components/FitCheck.tsx';
---

<BaseLayout
  title="Fit Check"
  description="Paste a job description. Get an honest assessment of whether I'm the right person — including when I'm not."
  path="/fit-check/"
>
  <section class="section-container py-20">
    <div class="text-center mb-12">
      <h1 class="heading-section font-serif font-semibold mb-4">Honest Fit Assessment</h1>
      <p class="text-muted-foreground max-w-2xl mx-auto">
        Paste a job description. Get an honest assessment of whether I'm the right person —
        including when I'm not.
      </p>
    </div>

    <FitCheck client:load />
  </section>
</BaseLayout>
