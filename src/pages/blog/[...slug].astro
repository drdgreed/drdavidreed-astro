---
/**
 * /blog/[slug] — single article page.
 *
 * - getStaticPaths produces one route per non-draft post at build time.
 * - Pulls post data + renders MDX body via <Content />.
 * - Article JSON-LD goes in via <BaseLayout articleData={...} />.
 * - Related articles: same category, exclude current, take 2.
 *
 * Components available inside MDX bodies:
 *   PullQuote, InlineCTA, plus standard markdown.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import InlineCTA from '../../components/InlineCTA.astro';
import NewsletterCapture from '../../components/NewsletterCapture.astro';
import { CATEGORY_META } from '../../lib/categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  // v6: `post.id` replaces removed `post.slug`. Use it for both the route
  // param and the canonical URL inside the page.
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
// v6: render() is a top-level import; post.render() was removed.
const { Content } = await render(post);
const { title, description, category, publishDate, updatedDate, coverImage, readTime } =
  post.data;
const cat = CATEGORY_META[category];

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Related: same category, not this post, sorted by date desc, take 2.
const all = await getCollection('blog', ({ data }) => !data.draft);
const related = all
  .filter((p) => p.data.category === category && p.id !== post.id)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 2);
---

<BaseLayout
  title={title}
  description={description}
  path={`/blog/${post.id}/`}
  ogImage={coverImage}
  pageType="article"
  articleData={{
    headline: title,
    datePublished: publishDate,
    dateModified: updatedDate,
    image: coverImage,
    description,
  }}
>
  <article class="max-w-3xl mx-auto px-6 pt-12 pb-20">
    {/* Back link */}
    <a
      href="/blog/"
      class="inline-flex items-center gap-2 text-sm text-text-secondary hover:text-accent transition-colors mb-10"
    >
      ← All writing
    </a>

    {/* Category + title */}
    <div class="mb-10">
      <span class="inline-block px-2.5 py-1 rounded text-xs font-medium bg-accent-dark text-accent mb-5">
        {cat.label}
      </span>
      <h1 class="font-serif text-4xl md:text-5xl leading-tight tracking-tight mb-5">
        {title}
      </h1>
      <p class="text-text-secondary text-lg leading-relaxed">{description}</p>
    </div>

    {/* Byline */}
    <div class="flex items-center gap-4 pb-8 mb-12 border-b border-border-subtle">
      <div class="w-11 h-11 rounded-full bg-accent-dark flex items-center justify-center font-serif text-accent">
        DR
      </div>
      <div class="flex-1 text-sm">
        <div class="font-medium text-text-primary">David Reed, PhD</div>
        <div class="text-text-tertiary">
          Head of AI/ML & Agentic Delivery ·
          <time datetime={publishDate.toISOString()}> {formattedDate}</time> ·
          {readTime} min read
        </div>
      </div>
    </div>

    {/* Cover image */}
    {coverImage && (
      <img
        src={coverImage}
        alt=""
        class="w-full rounded-2xl border border-border-subtle mb-12"
      />
    )}

    {/* Body — MDX renders here. The `prose` classes (Tailwind Typography
        plugin) aren't included; instead we style markdown elements via
        nested selectors in this scope. Keeps the design system in charge. */}
    <div class="article-body">
      <Content />
    </div>

    {/* Inline CTA before bio */}
    <InlineCTA />

    {/* Author bio */}
    <AuthorCard variant="bio" />

    {/* Newsletter */}
    <NewsletterCapture />
  </article>

  {/* Related */}
  {related.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-20 border-t border-border-subtle pt-16">
      <p class="text-text-tertiary text-xs uppercase tracking-widest mb-6">
        More on {cat.label}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {related.map((p) => <ArticleCard post={p} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /**
   * Article body styling — applies to MDX-rendered children only.
   * Tailwind v4 lets us use @apply inside <style> blocks for token reuse.
   */
  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1.2;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }
  .article-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .article-body :global(p) {
    color: var(--color-text-primary);
    line-height: 1.75;
    margin-bottom: 1.25rem;
    font-size: 1.0625rem;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    color: var(--color-text-primary);
    line-height: 1.75;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .article-body :global(ul) {
    list-style: disc;
  }
  .article-body :global(ol) {
    list-style: decimal;
  }
  .article-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .article-body :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .article-body :global(code) {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.875em;
    font-family: var(--default-mono-font-family);
  }
  .article-body :global(pre) {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.875em;
  }
  .article-body :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
  }
  .article-body :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    color: var(--color-text-secondary);
    margin: 1.5rem 0;
    font-style: italic;
  }
  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border-subtle);
    margin: 2.5rem 0;
  }
  .article-body :global(img) {
    border-radius: 8px;
    margin: 1.5rem 0;
  }
</style>
