---
/**
 * /blog — listing page.
 *
 * - Filters out drafts at build time.
 * - Sorts by publishDate desc.
 * - First post tagged `featured: true` becomes the hero card.
 * - Remaining posts go into the grid.
 * - Category chips toggle visibility client-side (no full-page reload).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { BLOG_CATEGORIES } from '../../content.config';
import { CATEGORY_META } from '../../lib/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const featured = posts.find((p) => p.data.featured);
// v6: use `id` instead of removed `slug` property.
const rest = featured ? posts.filter((p) => p.id !== featured.id) : posts;
---

<BaseLayout
  title="Writing"
  description="Production agentic systems, ML engineering at scale, and notes for senior technical leaders. By David Reed, PhD."
  path="/blog/"
>
  {/* Hero */}
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-12">
    <p class="text-accent text-sm font-medium uppercase tracking-widest mb-4">Writing</p>
    <h1 class="font-serif text-5xl md:text-6xl leading-tight mb-6 max-w-3xl">
      Notes from production AI/ML systems —
      <span class="text-text-secondary">written for the people who ship them.</span>
    </h1>
    <p class="text-text-secondary text-lg max-w-2xl leading-relaxed">
      Deep-dive essays on agentic AI, multi-agent orchestration, ML engineering at scale,
      and what senior technical leadership actually looks like day-to-day.
    </p>
  </section>

  {/* Category chips — client-filtered. data-category attribute on each card
      drives show/hide. The "all" chip resets. */}
  <section class="max-w-6xl mx-auto px-6 pb-10">
    <div id="category-chips" class="flex flex-wrap gap-2">
      <button
        type="button"
        data-filter="all"
        class="filter-chip px-4 py-2 rounded-full border text-sm border-accent bg-accent text-bg-primary transition-colors"
      >
        All
      </button>
      {BLOG_CATEGORIES.map((cat) => (
        <button
          type="button"
          data-filter={cat}
          class="filter-chip px-4 py-2 rounded-full border text-sm border-border-subtle text-text-secondary hover:border-accent hover:text-accent transition-colors"
        >
          {CATEGORY_META[cat].label}
        </button>
      ))}
    </div>
  </section>

  {/* Featured card */}
  {featured && (
    <section class="max-w-6xl mx-auto px-6 pb-16" data-section-featured>
      <p class="text-text-tertiary text-xs uppercase tracking-widest mb-4">Featured</p>
      <ArticleCard post={featured} featured={true} />
    </section>
  )}

  {/* Grid */}
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <p class="text-text-tertiary text-xs uppercase tracking-widest mb-4">All posts</p>
    <div id="post-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {rest.map((post) => <ArticleCard post={post} />)}
    </div>
    {rest.length === 0 && !featured && (
      <p class="text-text-secondary">No posts yet.</p>
    )}
  </section>

  {/* CTA */}
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <AuthorCard variant="cta" />
  </section>
</BaseLayout>

<script>
  /**
   * Client-side category filter.
   * Each chip carries `data-filter`; cards carry `data-category`.
   * The "all" chip clears any active filter.
   * The featured section is also hidden when its category doesn't match.
   */
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const featuredSection = document.querySelector<HTMLElement>('[data-section-featured]');

  const setActive = (filter: string) => {
    chips.forEach((c) => {
      const active = c.dataset.filter === filter;
      c.classList.toggle('border-accent', active);
      c.classList.toggle('bg-accent', active);
      c.classList.toggle('text-bg-primary', active);
      c.classList.toggle('border-border-subtle', !active);
      c.classList.toggle('text-text-secondary', !active);
    });

    cards.forEach((card) => {
      const matches = filter === 'all' || card.dataset.category === filter;
      card.style.display = matches ? '' : 'none';
    });

    if (featuredSection) {
      const featuredCard = featuredSection.querySelector<HTMLElement>('[data-category]');
      const matches =
        filter === 'all' ||
        (featuredCard && featuredCard.dataset.category === filter);
      featuredSection.style.display = matches ? '' : 'none';
    }
  };

  chips.forEach((chip) => {
    chip.addEventListener('click', () => setActive(chip.dataset.filter ?? 'all'));
  });
</script>
