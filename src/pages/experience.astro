---
/**
 * /experience — career timeline + honest skills matrix.
 *
 * Two sections that used to live as scroll-target sections on the Lovable
 * home page. Splitting them out gives them their own URL (better SEO,
 * deep-linkable in interviews).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
---

<BaseLayout
  title="Experience"
  description="Career timeline and an honest skills inventory — strong areas, moderate areas, and gaps."
  path="/experience/"
>
  <section class="section-container py-20">
    <div class="text-center mb-12">
      <h1 class="heading-section font-serif font-semibold mb-4">Experience</h1>
      <p class="text-muted-foreground max-w-2xl mx-auto">
        A timeline of my professional journey and key achievements.
      </p>
    </div>
    <ExperienceTimeline />
  </section>

  <section class="section-container py-20 border-t border-border">
    <div class="text-center mb-12">
      <h2 class="heading-section font-serif font-semibold mb-4">Skills Matrix</h2>
      <p class="text-muted-foreground max-w-2xl mx-auto">
        An honest assessment of where I excel, where I'm growing, and where I have gaps.
      </p>
    </div>
    <SkillsMatrix />
  </section>
</BaseLayout>
