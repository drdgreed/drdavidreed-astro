---
/**
 * / — Home page.
 *
 * Hero-focused. Quick links + Book-a-call CTA route the visitor to
 * the rest of the site or directly to Calendly.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { SITE } from '../lib/site-meta';
---

<BaseLayout
  title={profile.name}
  description={profile.elevatorPitch}
  path="/"
  pageType="profile"
>
  <section class="min-h-[calc(100vh-4rem)] flex flex-col justify-center items-center relative">
    {/* Soft gradient halo behind the hero */}
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse at 50% 35%, rgb(52 211 153 / 0.08) 0%, transparent 60%)"
    ></div>

    <div class="section-container text-center relative z-10 py-20">
      {/* Status pill */}
      <div
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full glass-card mb-12"
        style="animation: badge-glow 2s ease-in-out infinite"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse" style="box-shadow: 0 0 8px rgb(52 211 153 / 0.8)"></span>
        <span class="text-sm text-muted-foreground">
          Open to <span class="text-foreground font-medium">{profile.availability.targetTitles[0]} / {profile.availability.targetTitles[1]}</span>
          at <span class="text-foreground font-medium">{profile.availability.targetStages.slice(0, 2).join('-')}</span>
        </span>
      </div>

      {/* Name */}
      <h1 class="heading-hero font-serif font-semibold mb-6 tracking-tight animate-fade-in">
        {profile.name}
      </h1>

      {/* Title */}
      <p class="text-2xl md:text-3xl text-primary font-medium mb-8 animate-fade-in" style="animation-delay: 80ms">
        {profile.title}
      </p>

      {/* Pitch */}
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto mb-14 leading-relaxed animate-fade-in" style="animation-delay: 160ms">
        {profile.elevatorPitch}
      </p>

      {/* Target stages as pills */}
      <div class="flex flex-wrap justify-center gap-3 mb-12 animate-fade-in" style="animation-delay: 240ms">
        {profile.availability.targetStages.map((stage) => (
          <span class="px-5 py-2.5 text-sm font-medium rounded-full border border-border text-muted-foreground bg-muted/40 hover:border-primary/50 hover:text-foreground hover:bg-muted/60 transition-all duration-300 cursor-default">
            {stage}
          </span>
        ))}
      </div>

      {/* CTAs */}
      <div class="flex flex-wrap justify-center gap-3 mb-12 animate-fade-in" style="animation-delay: 320ms">
        <a
          href={SITE.calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-glow inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-lg text-base font-medium hover:bg-primary-hover transition-colors shadow-lg shadow-primary/20 animate-pulse-glow"
        >
          Book a 30-min call
        </a>
        <a
          href="/experience/"
          class="inline-flex items-center gap-2 px-6 py-3 border border-border rounded-lg text-base font-medium hover:border-primary hover:text-primary transition-colors"
        >
          See experience →
        </a>
        <a
          href={SITE.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 border border-border rounded-lg text-base font-medium hover:border-primary hover:text-primary transition-colors"
        >
          Connect on LinkedIn
        </a>
      </div>

      {/* Quick navigation hints */}
      <p class="text-xs text-text-tertiary uppercase tracking-widest">
        <a href="/portfolio/" class="hover:text-primary transition-colors">Portfolio</a>
        <span class="mx-3">·</span>
        <a href="/blog/" class="hover:text-primary transition-colors">Writing</a>
        <span class="mx-3">·</span>
        <a href={`mailto:${SITE.email}`} class="hover:text-primary transition-colors">Email</a>
      </p>
    </div>
  </section>
</BaseLayout>
