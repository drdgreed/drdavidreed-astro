---
/**
 * <SEO /> — single source of truth for per-page meta.
 *
 * Outputs:
 *   - <title>, meta description
 *   - canonical link (absolute)
 *   - Open Graph (og:title, og:description, og:image, og:type, og:url)
 *   - Twitter card (summary_large_image)
 *   - JSON-LD: Person sitewide; Article when articleData is provided
 *
 * Used by BaseLayout — every page goes through this component automatically.
 */
import { SITE, PERSON } from '../lib/site-meta';
import type { SeoProps } from '../lib/seo-types';

type Props = SeoProps;

const {
  title,
  description = SITE.description,
  path,
  ogImage,
  articleData,
  pageType = articleData ? 'article' : 'website',
} = Astro.props;

// Canonical and OG URLs must be absolute.
const canonical = new URL(path, SITE.url).toString();
const resolvedOgImage = new URL(ogImage ?? SITE.defaultOgImage, SITE.url).toString();

const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

/**
 * Normalize a Date|string|undefined into an ISO-8601 string (or undefined).
 * Centralizing this avoids repeated `instanceof Date` ternaries that
 * easily go wrong with non-null assertions.
 */
const toIso = (value: string | Date | undefined): string | undefined => {
  if (!value) return undefined;
  return value instanceof Date ? value.toISOString() : value;
};

const datePublishedIso = toIso(articleData?.datePublished);
// Modified date defaults to published date — schema.org Article requires
// dateModified for fresh-content signals; matching dates is the correct
// fallback when the post hasn't been updated.
const dateModifiedIso = toIso(articleData?.dateModified) ?? datePublishedIso;

// JSON-LD: Person is always present so search engines can stitch identity
// across every page. Article is added only on blog posts.
const personLd = PERSON;

const articleLd = articleData
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: articleData.headline,
      description: articleData.description ?? description,
      image: new URL(articleData.image ?? SITE.defaultOgImage, SITE.url).toString(),
      datePublished: datePublishedIso,
      dateModified: dateModifiedIso,
      author: { '@id': `${SITE.url}/#person` },
      publisher: { '@id': `${SITE.url}/#person` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    }
  : null;

// Wrap Person in @context only when emitted as a standalone block.
const personLdBlock = {
  '@context': 'https://schema.org',
  ...personLd,
};
---

{/* Primary meta */}
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large" />

{/* Open Graph */}
<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.language.replace('-', '_')} />

{/* Twitter card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
{SITE.twitterHandle ? <meta name="twitter:creator" content={SITE.twitterHandle} /> : null}

{/* Article meta (only on blog posts) */}
{articleData && datePublishedIso && (
  <>
    <meta property="article:author" content={PERSON.name} />
    <meta property="article:published_time" content={datePublishedIso} />
    {articleData.dateModified && dateModifiedIso && (
      <meta property="article:modified_time" content={dateModifiedIso} />
    )}
  </>
)}

{/* Person JSON-LD — sitewide */}
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(personLdBlock)}
/>

{/* Article JSON-LD — only on blog posts */}
{articleLd && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleLd)}
  />
)}
