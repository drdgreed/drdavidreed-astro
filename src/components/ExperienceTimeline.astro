---
/**
 * <ExperienceTimeline /> — vertical timeline of career roles.
 * Pulls from src/data/experience.ts.
 *
 * Each row: timeline rail + dot + date label + glass card with achievements.
 * Mobile collapses the date column above the card.
 */
import { experiences, type Experience } from '../data/experience';

const fmtMonth = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const dateRange = (e: Experience) => {
  const start = fmtMonth(e.startDate);
  if (e.isCurrent) return `${start} — Present`;
  if (!e.endDate) return start;
  return `${start} — ${fmtMonth(e.endDate)}`;
};
---

<div class="space-y-8">
  {experiences.map((exp, idx) => {
    const isLast = idx === experiences.length - 1;
    return (
      <div class="relative flex gap-6">
        {/* Timeline rail (desktop) */}
        <div class="hidden md:flex flex-col items-center">
          <div
            class={`w-4 h-4 rounded-full border-4 border-background z-10 shrink-0 ${
              exp.isCurrent ? 'bg-primary' : 'bg-muted-foreground/50'
            }`}
          ></div>
          {!isLast && <div class="w-0.5 flex-1 mt-2 bg-gradient-to-b from-primary/50 to-border"></div>}
        </div>

        {/* Date column (desktop) */}
        <div class="hidden md:block w-36 shrink-0 pt-0.5">
          <span class="label-uppercase text-primary font-semibold">{dateRange(exp)}</span>
        </div>

        {/* Card */}
        <div class="flex-1 glass-card-hover p-6">
          <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
            <div>
              <h3 class="text-xl font-serif font-semibold text-foreground flex items-center gap-2 flex-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                  <rect width="20" height="14" x="2" y="7" rx="2" ry="2" />
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                </svg>
                {exp.company}
                {exp.isCurrent && (
                  <span class="px-2 py-0.5 text-xs rounded-full bg-primary/20 text-primary font-medium">
                    Current
                  </span>
                )}
              </h3>
              <p class="text-primary font-medium mt-1">
                {exp.title}
                {exp.titleProgression && (
                  <span class="text-muted-foreground font-normal ml-2">→ {exp.titleProgression}</span>
                )}
              </p>
            </div>
            {/* Mobile date */}
            <span class="md:hidden label-uppercase text-primary font-semibold">{dateRange(exp)}</span>
          </div>

          {exp.bulletPoints.length > 0 && (
            <ul class="space-y-2.5">
              {exp.bulletPoints.map((bp) => (
                <li class="text-muted-foreground flex items-start gap-3">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 mt-0.5" aria-hidden="true">
                    <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                    <path d="m9 11 3 3L22 4" />
                  </svg>
                  <span>{bp}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    );
  })}
</div>
